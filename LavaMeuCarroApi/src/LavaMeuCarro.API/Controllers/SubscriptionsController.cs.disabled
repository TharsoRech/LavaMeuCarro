using LavaMeuCarro.Application.Commands.Card.DeleteCardCommand;
using LavaMeuCarro.Application.Commands.Card.GetCardsQuery;
using LavaMeuCarro.Application.Commands.Card.SaveCardCommand;
using LavaMeuCarro.Application.Commands.Card.SetDefaultCardCommand;
using LavaMeuCarro.Application.Commands.Subscription.ActivateTrialCommand;
using LavaMeuCarro.Application.Commands.Subscription.CancelSubscriptionForUserCommand;
using LavaMeuCarro.Application.Commands.Subscription.EnsureSubscriptionCommand;
using LavaMeuCarro.Application.Commands.Subscription.GetCurrentSubscriptionQuery;
using LavaMeuCarro.Application.Commands.Subscription.ProcessAsaasWebhookCommand;
using LavaMeuCarro.Application.Commands.Subscription.ProcessPaidSubscriptionCommand;
using LavaMeuCarro.Application.Commands.Subscription.StartAsaasCheckoutCommand;
using LavaMeuCarro.Application.Commands.Subscription.VerifyAppleReceiptCommand;
using LavaMeuCarro.Application.DTOs;
using LavaMeuCarro.Application.Interfaces;
using MediatR;
using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;
using System.Globalization;
