public record CreateAppointmentFeedbackCommand(
    int AppointmentId,
    int UserId,
    int? SalonRating,
    int? ProfessionalRating,
    string? Comment) : IRequest<CreateAppointmentFeedbackResult>;

public record CreateAppointmentFeedbackResult(
