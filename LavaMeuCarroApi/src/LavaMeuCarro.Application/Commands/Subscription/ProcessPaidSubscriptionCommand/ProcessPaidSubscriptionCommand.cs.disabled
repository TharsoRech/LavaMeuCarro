using LavaMeuCarro.Application.DTOs;
using MediatR;

namespace LavaMeuCarro.Application.Commands.Subscription.ProcessPaidSubscriptionCommand;

public record ProcessPaidSubscriptionCommand(
    int UserId,
    int PlanId,
    NormalizedCardData? CardData,
    IEnumerable<LegalConsentRequest>? Consents,
    string? IpAddress,
    string? UserAgent,
    bool IsUpgrade = false) : IRequest<ProcessPaidSubscriptionResult>;

public record ProcessPaidSubscriptionResult(SubscriptionDto Subscription);

public record NormalizedCardData(
    string CardNumber,
    string CardHolderName,
    string ExpiryMonth,
    string ExpiryYear,
    string Brand);

