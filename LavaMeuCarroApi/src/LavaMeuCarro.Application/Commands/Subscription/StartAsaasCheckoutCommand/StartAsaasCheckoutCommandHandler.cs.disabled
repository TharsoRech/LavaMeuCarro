using LavaMeuCarro.Application.DTOs;
using LavaMeuCarro.Application.Interfaces;
using LavaMeuCarro.Domain.Enums;
using LavaMeuCarro.Domain.Exceptions;
using MediatR;

namespace LavaMeuCarro.Application.Commands.Subscription.StartAsaasCheckoutCommand;

public class StartAsaasCheckoutCommandHandler(
    IPlanRepository planRepository,
    IUserRepository userRepository,
    ILegalDocumentRepository legalDocumentRepository,
    IAsaasSubscriptionGateway asaasGateway,
    IAsaasWebhookAuditRepository asaasWebhookAuditRepository)
    : IRequestHandler<StartAsaasCheckoutCommand, StartAsaasCheckoutResult>
{
    private static readonly TimeSpan CheckoutLockDuration = TimeSpan.FromMinutes(25);

    public async Task<StartAsaasCheckoutResult> Handle(StartAsaasCheckoutCommand request, CancellationToken ct)
    {
        if (!asaasGateway.IsConfigured())
            return new StartAsaasCheckoutResult(false, 503, null, null, null, "Gateway de pagamento indisponivel no momento.");

        var activeLock = await asaasWebhookAuditRepository.GetActiveCheckoutLockAsync(request.UserId, ct);
        if (activeLock is not null)
        {
            // Comportamento antigo bloqueava nova tentativa por 25min (retornava 409).
            // Novo comportamento: cancelar automaticamente o lock pendente anterior e
            // permitir que o usuario inicie um novo checkout. Assim o cliente nunca fica
            // "travado" caso tenha fechado o checkout sem pagar.
            await asaasWebhookAuditRepository.ResolveCheckoutLockAsync(
                activeLock.ExternalReference,
                request.UserId,
                "CANCELLED",
                "Substituido por novo checkout iniciado pelo usuario.",
                "REPLACED_BY_NEW_CHECKOUT",
                null,
                null,
                ct);
        }

        var plan = await planRepository.GetByIdAsync(request.PlanId);
        if (plan is null)
            return new StartAsaasCheckoutResult(false, 404, null, null, null, "Plan not found.");

        if (plan.PlanType == PlanType.Trial || plan.Price <= 0)
            return new StartAsaasCheckoutResult(false, 400, null, null, null, "Este endpoint aceita apenas planos pagos mensais.");

        var user = await userRepository.GetByIdAsync(request.UserId);
        if (user is null || string.IsNullOrWhiteSpace(user.Email))
            return new StartAsaasCheckoutResult(false, 400, null, null, null, "Usuario sem email valido para checkout.");

        await ValidateConsentsAsync(request.Consents, legalDocumentRepository);

        var externalReference = $"user:{request.UserId}|plan:{plan.Id}|ts:{DateTimeOffset.UtcNow.ToUnixTimeSeconds()}";
        var lockCreatedAt = DateTime.UtcNow;

        try
        {
            await asaasWebhookAuditRepository.UpsertCheckoutLockAsync(new Domain.Entities.AsaasCheckoutLock
            {
                UserId = request.UserId,
                PlanId = plan.Id,
                ExternalReference = externalReference,
                CheckoutUrl = null,
                Status = "PENDING",
                CreatedAt = lockCreatedAt,
                UpdatedAt = lockCreatedAt,
                ExpiresAt = lockCreatedAt.Add(CheckoutLockDuration)
            }, ct);
        }
        catch
        {
            var concurrentLock = await asaasWebhookAuditRepository.GetActiveCheckoutLockAsync(request.UserId, ct);
            if (concurrentLock is not null)
            {
                var pendingUntilUtc = DateTime.SpecifyKind(concurrentLock.ExpiresAt, DateTimeKind.Utc);
                return new StartAsaasCheckoutResult(
                    false,
                    409,
                    concurrentLock.CheckoutUrl,
                    concurrentLock.ExternalReference,
                    concurrentLock.Status,
                    "Ja existe um checkout em andamento para sua conta. Aguarde a confirmacao do pagamento ou fale com o suporte.",
                    pendingUntilUtc,
                    true);
            }

            throw;
        }

        AsaasCheckoutSessionInfo checkout;
        try
        {
            checkout = await asaasGateway.CreateRecurringCheckoutAsync(
                new AsaasCheckoutRequestInfo(
                    request.UserId,
                    plan.Id,
                    user.Email.Trim(),
                    user.Name,
                    user.Doc,
                    $"{plan.Name} - assinatura mensal",
                    plan.Price,
                    externalReference,
                    request.BackUrl),
                ct);
        }
        catch (Exception ex)
        {
            await asaasWebhookAuditRepository.ResolveCheckoutLockAsync(
                externalReference,
                request.UserId,
                "FAILED",
                "Falha ao criar checkout no gateway de pagamento.",
                "CHECKOUT_CREATION_FAILED",
                null,
                null,
                ct);

            if (ex is InvalidOperationException invalidOperation)
            {
                var gatewayMessage = string.IsNullOrWhiteSpace(invalidOperation.Message)
                    ? "Nao foi possivel iniciar o checkout no gateway de pagamento."
                    : invalidOperation.Message;

                return new StartAsaasCheckoutResult(
                    false,
                    422,
                    null,
                    externalReference,
                    "FAILED",
                    gatewayMessage,
                    lockCreatedAt.Add(CheckoutLockDuration));
            }

            return new StartAsaasCheckoutResult(
                false,
                503,
                null,
                externalReference,
                "FAILED",
                "Servico de pagamento indisponivel no momento. Tente novamente em instantes.",
                lockCreatedAt.Add(CheckoutLockDuration));
        }

        await asaasWebhookAuditRepository.UpsertCheckoutLockAsync(new Domain.Entities.AsaasCheckoutLock
        {
            UserId = request.UserId,
            PlanId = plan.Id,
            ExternalReference = externalReference,
            CheckoutUrl = checkout.CheckoutUrl,
            Status = "PENDING",
            CreatedAt = lockCreatedAt,
            UpdatedAt = lockCreatedAt,
            ExpiresAt = lockCreatedAt.Add(CheckoutLockDuration)
        }, ct);

        await legalDocumentRepository.SaveAcceptedConsentsAsync(
            request.UserId, "subscription", request.Consents ?? [], request.IpAddress, request.UserAgent);

        return new StartAsaasCheckoutResult(
            true,
            200,
            checkout.CheckoutUrl,
            externalReference,
            checkout.Status,
            null,
            lockCreatedAt.Add(CheckoutLockDuration));
    }

    private static async Task ValidateConsentsAsync(
        IEnumerable<LegalConsentRequest>? consents,
        ILegalDocumentRepository legalDocumentRepository)
    {
        var required = (await legalDocumentRepository.GetActiveByContextAsync("subscription"))
            .Where(d => d.IsRequired).ToList();

        if (required.Count == 0) return;

        var accepted = (consents ?? [])
            .Where(c => !string.IsNullOrWhiteSpace(c.Code) && !string.IsNullOrWhiteSpace(c.Version))
            .ToDictionary(c => c.Code.Trim(), c => c.Version.Trim(), StringComparer.OrdinalIgnoreCase);

        var missing = required
            .Where(d => !accepted.TryGetValue(d.Code, out var v) || !string.Equals(v, d.Version, StringComparison.OrdinalIgnoreCase))
            .Select(d => d.Title).ToList();

        if (missing.Count > 0)
            throw new BusinessException($"Aceite obrigatório pendente: {string.Join(", ", missing)}.");
    }
}
