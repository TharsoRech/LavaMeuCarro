using GetCurrentSubQuery = LavaMeuCarro.Application.Commands.Subscription.GetCurrentSubscriptionQuery.GetCurrentSubscriptionQuery;
using LavaMeuCarro.Application.DTOs;
using LavaMeuCarro.Application.Interfaces;
using LavaMeuCarro.Domain.Enums;
using LavaMeuCarro.Domain.Exceptions;
using MediatR;
using Microsoft.Extensions.Logging;

namespace LavaMeuCarro.Application.Commands.Subscription.CancelSubscriptionForUserCommand;

public class CancelSubscriptionForUserCommandHandler(
    ISubscriptionRepository subscriptionRepository,
    ISalonRepository salonRepository,
    IUserRepository userRepository,
    IPlanRepository planRepository,
    IAsaasSubscriptionGateway asaasGateway,
    IAsaasWebhookAuditRepository asaasWebhookAuditRepository,
    ISubscriptionEmailService subscriptionEmailService,
    IMediator mediator,
    ILogger<CancelSubscriptionForUserCommandHandler> logger)
    : IRequestHandler<CancelSubscriptionForUserCommand, CancelSubscriptionForUserResult>
{
    public async Task<CancelSubscriptionForUserResult> Handle(CancelSubscriptionForUserCommand request, CancellationToken ct)
    {
        var active = await subscriptionRepository.GetActiveByUserAsync(request.UserId);
        if (active is null)
        {
            await salonRepository.UnpublishByOwnerAsync(request.UserId, ct);
            var noop = await mediator.Send(new GetCurrentSubQuery(request.UserId), ct);
            return new CancelSubscriptionForUserResult(noop);
        }

        var planIdToNotify = active.PlanId;
        var gatewayAttempted = !string.IsNullOrWhiteSpace(active.AsaasSubscriptionId);
        var gatewayCancelled = gatewayAttempted ? false : (bool?)null;
        var cancellationError = (string?)null;

        if (!string.IsNullOrWhiteSpace(active.AsaasSubscriptionId))
        {
            if (!asaasGateway.IsConfigured())
            {
                cancellationError = "Gateway de pagamento indisponivel. Tente novamente em instantes para cancelar sua cobranca com seguranca.";
                await PersistCancellationAttemptAsync(active, request, gatewayAttempted, gatewayCancelled, false, false, cancellationError, ct);
                throw new BusinessException(cancellationError);
            }

            try
            {
                var canceledInGateway = await asaasGateway.CancelSubscriptionAsync(active.AsaasSubscriptionId, ct);
                if (!canceledInGateway)
                {
                    cancellationError = "Nao foi possivel cancelar a cobranca no Asaas agora. Tente novamente em instantes.";
                    await PersistCancellationAttemptAsync(active, request, gatewayAttempted, false, false, false, cancellationError, ct);
                    throw new BusinessException(cancellationError);
                }

                gatewayCancelled = true;
            }
            catch (BusinessException)
            {
                throw;
            }
            catch (Exception ex)
            {
                logger.LogError(ex,
                    "[CancelSubscriptionForUser] Falha ao cancelar no Asaas. UserId={UserId}, AsaasSubscriptionId={AsaasSubscriptionId}.",
                    request.UserId,
                    active.AsaasSubscriptionId);
                cancellationError = "Nao foi possivel cancelar a cobranca no Asaas agora. Tente novamente em instantes.";
                await PersistCancellationAttemptAsync(active, request, gatewayAttempted, false, false, false, cancellationError, ct);
                throw new BusinessException(cancellationError);
            }
        }

        active.Status = SubscriptionStatus.Cancelled;
        await subscriptionRepository.UpdateAsync(active);
        await salonRepository.UnpublishByOwnerAsync(request.UserId, ct);

        await PersistCancellationAttemptAsync(active, request, gatewayAttempted, gatewayCancelled, true, true, null, ct);

        var current = await mediator.Send(new GetCurrentSubQuery(request.UserId), ct);

        var capturedUserId = request.UserId;
        _ = Task.Run(async () =>
        {
            try
            {
                var user = await userRepository.GetByIdAsync(capturedUserId);
                var plan = await planRepository.GetByIdAsync(planIdToNotify);
                if (user is not null && plan is not null)
                    await subscriptionEmailService.SendSubscriptionCancelledAsync(user, plan);
            }
            catch (Exception ex)
            {
                logger.LogError(ex, "[CancelSubscriptionForUser] Falha ao enviar e-mail. UserId={UserId}.", capturedUserId);
            }
        });

        return new CancelSubscriptionForUserResult(current with { Status = SubscriptionStatus.Cancelled, IsActive = false });
    }

    private Task PersistCancellationAttemptAsync(
        Domain.Entities.Subscription active,
        CancelSubscriptionForUserCommand request,
        bool gatewayAttempted,
        bool? gatewayCancelled,
        bool localCancelled,
        bool success,
        string? errorMessage,
        CancellationToken cancellationToken)
        => asaasWebhookAuditRepository.CreateCancellationAttemptAsync(new Domain.Entities.SubscriptionCancellationAttempt
        {
            SubscriptionId = active.Id,
            UserId = request.UserId,
            PlanId = active.PlanId,
            AsaasSubscriptionId = active.AsaasSubscriptionId,
            Source = string.IsNullOrWhiteSpace(request.Source) ? "user" : request.Source.Trim(),
            Reason = request.Reason,
            GatewayCancelAttempted = gatewayAttempted,
            GatewayCancelled = gatewayCancelled,
            LocalCancelled = localCancelled,
            Success = success,
            ErrorMessage = errorMessage,
            CreatedAt = DateTime.UtcNow
        }, cancellationToken);
}

