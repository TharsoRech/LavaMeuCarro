using LavaMeuCarro.Application.DTOs;
using LavaMeuCarro.Application.Interfaces;
using MediatR;

namespace LavaMeuCarro.Application.Queries.ListSalonReviewsQuery;

public class ListSalonReviewsQueryHandler : IRequestHandler<ListSalonReviewsQuery, IEnumerable<ReviewDto>>
{
    private readonly IReviewRepository _repo;
    private readonly IUserRepository _userRepository;
    public ListSalonReviewsQueryHandler(IReviewRepository repo, IUserRepository userRepository)
    {
        _repo = repo;
        _userRepository = userRepository;
    }

    public async Task<IEnumerable<ReviewDto>> Handle(Queries.ListSalonReviewsQuery.ListSalonReviewsQuery req, CancellationToken ct)
    {
        var items = await _repo.ListBySalonAsync(req.SalonId);
        var usersById = new Dictionary<int, string>();
        var result = new List<ReviewDto>();

        foreach (var review in items)
        {
            if (!usersById.TryGetValue(review.ClientId, out var clientName))
            {
                var user = await _userRepository.GetByIdAsync(review.ClientId);
                clientName = string.IsNullOrWhiteSpace(user?.Name) ? "Cliente" : user.Name;
                usersById[review.ClientId] = clientName;
            }

            result.Add(new ReviewDto(
                review.Id,
                review.AppointmentId,
                review.ClientId,
                clientName,
                review.Rating,
                review.Comment,
                review.CreatedAt));
        }

        return result;
    }
}
