{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dotnet-build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/LavaMeuCarroApi/src/LavaMeuCarro.API/LavaMeuCarro.API.csproj"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "dotnet-watch",
      "command": "dotnet",
      "type": "process",
      "args": [
        "watch",
        "run",
        "--project",
        "${workspaceFolder}/LavaMeuCarroApi/src/LavaMeuCarro.API/LavaMeuCarro.API.csproj"
      ],
      "isBackground": true,
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "group": "servers"
      }
    },
    {
      "label": "vite-dev",
      "type": "npm",
      "script": "dev",
      "path": "${workspaceFolder}/Website/",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "ready in"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "group": "servers"
      }
    },
    {
      "label": "start-all",
      "dependsOn": ["dotnet-watch", "vite-dev"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "dotnet-clean",
      "command": "dotnet",
      "type": "process",
      "args": [
        "clean",
        "${workspaceFolder}/LavaMeuCarroApi/src/LavaMeuCarro.API/LavaMeuCarro.API.csproj"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "npm-install",
      "type": "npm",
      "script": "install",
      "path": "${workspaceFolder}/Website/",
      "problemMatcher": []
    }
  ]
}
